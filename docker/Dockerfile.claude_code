# PR-Agent GitHub App server that sends model calls through the Claude Code CLI.
#
#   docker build -f docker/Dockerfile.claude_code -t pr-agent-claude-code .
#
# Runtime environment (see docs/docs/usage-guide/changing_a_model.md#claude-code-cli):
#   CLAUDE_CODE_OAUTH_TOKEN   token from `claude setup-token`
#   GITHUB__APP_ID, GITHUB__PRIVATE_KEY, GITHUB__WEBHOOK_SECRET
FROM python:3.14.9-slim@sha256:35caba83af2fe6da9a5d922f9b0156f21d1246a48278c58a08bd253303ba42e8
COPY --from=ghcr.io/astral-sh/uv:0.13.5@sha256:32a7bb39b496babbd997b0a39a4d66c126bdaf5661b302bf6f06abda8deca6ff /uv /uvx /bin/

ENV LITELLM_LOCAL_MODEL_COST_MAP=True

# Node.js runs the Claude Code CLI.
RUN apt-get update && apt-get install --no-install-recommends -y git curl ca-certificates nodejs npm \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

ARG CLAUDE_CODE_VERSION=latest
RUN npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" && npm cache clean --force && claude --version

WORKDIR /app
ENV UV_COMPILE_BYTECODE=1
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project --no-dev --extra all
COPY docs docs
ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONPATH=/app

RUN groupadd --gid 10001 pragent && \
    useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin pragent && \
    mkdir -p /app/pr-agent-outputs /home/pragent/.claude && \
    chown pragent:pragent /app/pr-agent-outputs /home/pragent/.claude
ENV HOME=/home/pragent

COPY pr_agent pr_agent
COPY --chmod=755 docker/claude_code_healthcheck.sh /usr/local/bin/claude-code-healthcheck

# Sensible defaults for this image; override any of them with environment variables.
ENV CONFIG__AI_HANDLER=claude_code \
    CONFIG__MODEL=claude-sonnet-5-5 \
    CONFIG__FALLBACK_MODELS='["claude-opus-5-5"]' \
    CONFIG__AI_TIMEOUT=300 \
    DISABLE_AUTOUPDATER=1 \
    PORT=3000

USER 10001:10001
EXPOSE 3000
HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -fsS "http://127.0.0.1:${PORT}/" >/dev/null || exit 1
CMD ["python", "-m", "gunicorn", "-k", "uvicorn_worker.UvicornWorker", "-c", "pr_agent/servers/gunicorn_config.py", "--forwarded-allow-ips", "*", "pr_agent.servers.github_app:app"]
